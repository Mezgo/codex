{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airadar.local/schemas/ai-radar-daily-signals.schema.json",
  "title": "AI Radar Daily Signals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generatedAt",
    "query",
    "signals"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "kind": {
      "type": "string",
      "const": "ai-radar.daily-signals"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "prompt",
        "language",
        "topics"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source",
          "evidence",
          "impact",
          "action",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url",
              "publishedAt"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "publishedAt": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "summary"
            ],
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "medium-high",
                  "high",
                  "critical"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "monitor",
              "investigating",
              "open-opportunity",
              "pending-litigation"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "reasoningAgent"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "official",
                  "technical-repo",
                  "community",
                  "secondary-media",
                  "mixed"
                ]
              },
              "reasoningAgent": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "medium-high",
                  "high"
                ]
              },
              "reproducibility": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "medium-high",
                  "high"
                ]
              },
              "communityTraction": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "corroboratingSources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "url",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "secondary",
                    "community",
                    "technical"
                  ]
                },
                "publishedAt": {
                  "type": "string",
                  "format": "date"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "primarySourceValidation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "sourceType",
              "reason"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "warning",
                  "failed"
                ]
              },
              "sourceType": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary",
                  "community",
                  "technical",
                  "mixed",
                  "invalid",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "recommendedPrimarySource": {
                "type": "string",
                "format": "uri"
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "sourceComparison": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "confidence"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "agreements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "discrepancies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verdict": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "confirmed": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "probable": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "unresolved": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "refuted": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "medium-high",
                  "high"
                ]
              },
              "nextEvidence": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "hypothesis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "mechanism",
              "builder",
              "horizon",
              "minimumExperiment",
              "decision",
              "confidence"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "builder": {
                "type": "string",
                "minLength": 1
              },
              "horizon": {
                "type": "string",
                "minLength": 1
              },
              "evidenceFor": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidenceAgainst": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "confirmationSignals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "falsificationCriteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "minimumExperiment": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "enum": [
                  "probar ahora",
                  "vigilar",
                  "descartar por ahora"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          },
          "hypeAssessment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "score",
              "level",
              "recommendation"
            ],
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "dimensions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "verifiableEvidence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "noveltyMagnitude": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "practicalRelevance": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "reproducibility": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "sourceIndependence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  }
                }
              },
              "level": {
                "type": "string",
                "enum": [
                  "hype dominante",
                  "senal mixta",
                  "senal solida",
                  "evidencia excepcional"
                ]
              },
              "recommendation": {
                "type": "string",
                "enum": [
                  "probar",
                  "vigilar",
                  "ignorar por ahora"
                ]
              },
              "hypeFlags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "substanceFlags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "smallTest": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
